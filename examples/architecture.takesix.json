{
  "$schema": "https://raw.githubusercontent.com/vvapnik/takesix-core/main/schema/takesix-1.0.schema.json",
  "takesix": "1.0",
  "title": "SaaS app architecture",
  "description": "A tall block for the part that matters most, the request path along the top row",
  "blocks": [
    {
      "id": "clients", "at": "A1:B2", "icon": "📱", "title": "Clients",
      "description": "Web app and mobile apps",
      "children": [
        { "id": "web", "at": "A1:F1", "icon": "🖥", "title": "Web app", "description": "React SPA" },
        { "id": "mobile", "at": "A2:F2", "icon": "📱", "title": "Mobile apps", "description": "iOS and Android" }
      ]
    },
    {
      "id": "edge", "at": "C1:D1", "icon": "🌐", "title": "Edge",
      "description": "CDN, TLS, rate limits"
    },
    {
      "id": "auth", "at": "C2:D2", "icon": "🔑", "title": "Auth",
      "description": "Sign-in and tokens"
    },
    {
      "id": "app", "at": "E1:F2", "icon": "⚙️", "title": "Application",
      "description": "API and background jobs",
      "children": [
        { "id": "api", "at": "A1:C2", "title": "API", "description": "REST, the only way in" },
        { "id": "billing", "at": "D1:F1", "title": "Billing" },
        { "id": "projects", "at": "D2:F2", "title": "Projects" },
        { "id": "jobs", "at": "A3:F3", "title": "Background jobs", "description": "Emails, exports, cleanup" }
      ]
    },
    {
      "id": "ops", "at": "A3:D3", "icon": "📈", "title": "Operations",
      "description": "Logs, metrics, alerts, deploys"
    },
    {
      "id": "data", "at": "E3:F3", "icon": "🗄", "title": "Data",
      "description": "Postgres, Redis, S3",
      "details": "- **Postgres**: everything that must not be lost\n- **Redis**: sessions and queues\n- **S3**: uploads and exports"
    }
  ],
  "links": [
    { "id": "l1", "from": "web", "to": "edge", "label": "HTTPS" },
    { "id": "l2", "from": "mobile", "to": "edge", "label": "HTTPS" },
    { "id": "l3", "from": "edge", "to": "api" },
    { "id": "l4", "from": "api", "to": "billing" },
    { "id": "l5", "from": "api", "to": "projects" },
    { "id": "l6", "from": "auth", "to": "api", "label": "tokens" },
    { "id": "l7", "from": "projects", "to": "data", "label": "SQL" },
    { "id": "l8", "from": "ops", "to": "data", "label": "backups" }
  ]
}
