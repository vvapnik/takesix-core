{
  "$schema": "https://takesix.vapnik.de/schema/takesix-1.0.schema.json",
  "takesix": "1.0",
  "title": "Shop data model",
  "description": "A hub in the middle, every neighbour straight above, below or beside it; empty corners are left empty",
  "blocks": [
    { "id": "payment", "at": "C1:D1", "icon": "💳", "title": "Payment", "description": "One or more per order" },
    { "id": "customer", "at": "A2:B3", "icon": "👤", "title": "Customer", "description": "Account, addresses" },
    {
      "id": "order", "at": "C2:D3", "icon": "🧾", "title": "Order",
      "description": "The centre of the model",
      "children": [
        { "id": "order-head", "at": "A1:F1", "title": "Order", "description": "Number, status, totals" },
        { "id": "order-line", "at": "A2:D2", "title": "Order line", "description": "Product, quantity, price" },
        { "id": "order-discount", "at": "E2:F2", "title": "Discount" }
      ]
    },
    { "id": "product", "at": "E2:F3", "icon": "📦", "title": "Product", "description": "Catalogue, prices, stock" },
    { "id": "shipment", "at": "C4:D4", "icon": "🚚", "title": "Shipment", "description": "Carrier and tracking" }
  ],
  "links": [
    { "id": "l1", "from": "customer", "to": "order", "label": "places", "direction": "none" },
    { "id": "l2", "from": "order", "to": "product", "direction": "none" },
    { "id": "l3", "from": "order", "to": "payment", "direction": "none" },
    { "id": "l4", "from": "order", "to": "shipment", "direction": "none" },
    { "id": "l5", "from": "order-head", "to": "order-line", "label": "1 : n", "direction": "none" }
  ]
}
