{
  "$schema": "https://takesix.vapnik.de/schema/takesix-1.0.schema.json",
  "takesix": "1.0",
  "title": "Ship paid orders",
  "description": "An algorithm as a flowchart: ISO 5807 symbols, a loop, a condition and a retry",
  "blocks": [
    { "id": "start", "at": "C1:D1", "shape": "terminator", "title": "Start" },
    { "id": "read", "at": "C2:D2", "shape": "io", "title": "Read new orders", "description": "From the shop's queue" },
    { "id": "each", "at": "C3:D3", "shape": "loop-start", "title": "Each order" },
    {
      "id": "handle",
      "at": "C4:D4",
      "shape": "subprocess",
      "title": "Handle the order",
      "description": "Charge, then ship",
      "children": [
        { "id": "begin", "at": "A1:B1", "shape": "terminator", "title": "Begin" },
        { "id": "charge", "at": "A2:B2", "title": "Charge the card" },
        { "id": "paid", "at": "A3:B4", "shape": "decision", "title": "Paid?" },
        { "id": "wait", "at": "A5:B5", "title": "Wait an hour", "description": "Then try again" },
        { "id": "ship", "at": "E3:F4", "title": "Ship", "description": "Print the label, book the courier" },
        { "id": "done", "at": "E5:F5", "shape": "terminator", "title": "Done" }
      ]
    },
    { "id": "next", "at": "C5:D5", "shape": "loop-end", "title": "Next order" },
    { "id": "end", "at": "C6:D6", "shape": "terminator", "title": "End" }
  ],
  "links": [
    { "id": "l1", "from": "start", "to": "read" },
    { "id": "l2", "from": "read", "to": "each" },
    { "id": "l3", "from": "each", "to": "handle" },
    { "id": "l4", "from": "handle", "to": "next" },
    { "id": "l5", "from": "next", "to": "end" },
    { "id": "l6", "from": "begin", "to": "charge" },
    { "id": "l7", "from": "charge", "to": "paid" },
    { "id": "l8", "from": "paid", "to": "ship", "label": "yes" },
    { "id": "l9", "from": "paid", "to": "wait", "label": "no" },
    { "id": "l10", "from": "wait", "to": "charge", "label": "retry" },
    { "id": "l11", "from": "ship", "to": "done" }
  ]
}
