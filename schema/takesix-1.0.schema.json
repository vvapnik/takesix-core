{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vvapnik/takesix-core/main/schema/takesix-1.0.schema.json",
  "title": "takesix document",
  "description": "A diagram split into levels of at most 6 blocks. Structural rules that JSON Schema cannot express (unique ids, existing link endpoints) are checked by validateDocument() in @takesix/core.",
  "type": "object",
  "required": ["takesix", "title", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "takesix": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Format version."
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "layout": { "$ref": "#/$defs/layout" },
    "blocks": { "$ref": "#/$defs/blocks" },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "layout": {
      "enum": ["tiles", "list", "circle"],
      "description": "How children are arranged on screen."
    },
    "meta": {
      "type": "object",
      "description": "Free-form extension data, preserved as is."
    },
    "blocks": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/block" }
    },
    "block": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique across the whole document."
        },
        "title": { "type": "string", "minLength": 1 },
        "description": {
          "type": "string",
          "description": "Short plain-text summary shown on the card."
        },
        "details": {
          "type": "string",
          "description": "Long-form Markdown shown in the details panel."
        },
        "icon": { "type": "string" },
        "layout": { "$ref": "#/$defs/layout" },
        "children": { "$ref": "#/$defs/blocks" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "link": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "direction": {
          "enum": ["forward", "both", "none"],
          "default": "forward"
        },
        "meta": { "$ref": "#/$defs/meta" }
      }
    }
  }
}
